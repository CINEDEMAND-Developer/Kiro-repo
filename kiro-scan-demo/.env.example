# .env.example — copy to .env and fill in real values.
# NEVER commit .env to version control.

# A long, random string used to sign session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# Admin panel credentials. Use a strong password, not 'admin123'.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Set to "true" only in local development.
FLASK_DEBUG=false

# SQLite database file path.
DATABASE=users.db

# Directory where uploaded files are stored.
UPLOAD_FOLDER=/tmp/uploads

# Maximum file upload size in bytes (default: 5 MB).
MAX_UPLOAD_BYTES=5242880
